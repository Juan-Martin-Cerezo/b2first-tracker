[Unit]
Description=B2 First study portal (tracker + material)
After=network-online.target

[Service]
Type=simple
User=juan
WorkingDirectory=/home/juan/b2first-tracker
# Key de IA fuera del repo (chmod 600). El "-" al inicio = si no existe, arranca igual.
EnvironmentFile=-/home/juan/.config/b2first/ai.env
ExecStart=/usr/bin/python3 /home/juan/b2first-tracker/server.py
Restart=always
RestartSec=3
# Seguridad básica
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
